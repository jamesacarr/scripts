"*":
  "atom-beautify":
    general:
      analytics: false
  core:
    telemetryConsent: "no"
  editor:
    atomicSoftTabs: false
    preferredLineLength: 120
    showIndentGuide: true
    tabType: "soft"
  "exception-reporting":
    userId: "436a734e-d9cf-9f6f-253a-00294e50d652"
  "go-plus":
    disabledBundledPackages: [
      "go-signature-statusbar"
    ]
    panelDisplayMode: "closed"
    test:
      coverageDisplayMode: "gutter"
  "language-babel":
    autoIndentJSX: true
  "linter-eslint":
    fixOnSave: true
  "linter-jshint":
    disableWhenNoJshintrcFileInPath: true
  "linter-ui-default":
    showPanel: true
  "linter-xo":
    fixOnSave: true
  "package-sync":
    createOnChange: true
    forceOverwrite: true
  welcome:
    showOnStartup: false
