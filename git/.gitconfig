	email = james@jacarr.me
	signingkey = A79F57D8

[core]
	excludesfile = ~/.gitignore_global

[push]
	default = upstream

[commit]
	gpgsign = true

[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true

[rerere]
	enabled = true
	autoupdate = true
