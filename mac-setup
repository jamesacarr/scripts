# Install Homebrew and brews
echo "Installing Homebrew & brews"
if [[ -z $(which brew) ]]; then
  ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
fi
brew update
brew install autojump
brew install awscli
brew install git
Brew install gpg
brew install gpg-agent
brew install git-crypt
brew install httpie
brew install hub
brew install node
brew install macvim
brew install postgresql
brew install rbenv
brew install redis
brew install ruby-build
brew install sshpass
brew install yarn
brew install zsh
brew install zsh-syntax-highlighting

# Install ruby
echo "Installing Ruby"
eval "$(rbenv init -)"
rbenv install --skip-existing 2.3.3
rbenv global 2.3.3
rbenv rehash

gem install bundler

# Pull down prezto config
echo "Pull down Prezto & config"
git clone --recursive https://github.com/carrgo/prezto.git "${ZDOTDIR:-$HOME}/.zprezto"
cd "${ZDOTDIR:-$HOME}/.zprezto"
# git-crypt unlock

# Change shell to zsh
echo "Changing shell"
sudo dscl . -create /Users/$USER UserShell /usr/local/bin/zsh

echo "Setup complete. Please restart your terminal to get all the ZSH goodness."
